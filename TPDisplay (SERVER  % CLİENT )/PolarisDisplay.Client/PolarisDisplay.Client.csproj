<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Assets\TPPolarisClient.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Update="ClientForm.Runtime.cs">
      <DependentUpon>ClientForm.cs</DependentUpon>
    </Compile>
    <Compile Update="ClientForm.Designer.cs">
      <DependentUpon>ClientForm.cs</DependentUpon>
    </Compile>
    <Compile Update="ConnectionPage.Designer.cs">
      <DependentUpon>ConnectionPage.cs</DependentUpon>
    </Compile>
    <Compile Update="DisplayPage.Designer.cs">
      <DependentUpon>DisplayPage.cs</DependentUpon>
    </Compile>
    <Compile Update="AboutPage.Designer.cs">
      <DependentUpon>AboutPage.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="ClientForm.resx">
      <DependentUpon>ClientForm.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup><Compile Update="SettingsPage.Designer.cs"><DependentUpon>SettingsPage.cs</DependentUpon></Compile></ItemGroup>

  <ItemGroup>
    <Compile Update="ClientSettingsDialogForm.Designer.cs"><DependentUpon>ClientSettingsDialogForm.cs</DependentUpon></Compile>
    <Compile Update="PinDialogForm.Designer.cs"><DependentUpon>PinDialogForm.cs</DependentUpon></Compile>
  </ItemGroup>
</Project>
